{
  "version": 2,
  "functions": {
    "api/crm.js": { "maxDuration": 60 }
  },
  "routes": [
    { "src": "/api/crm/(.*)", "dest": "/api/crm.js", "methods": ["GET","POST","PUT","DELETE","PATCH","OPTIONS"] },
    { "src": "/login", "dest": "/login.html" },
    { "src": "/onboarding", "dest": "/onboarding.html" },
    { "src": "/painel", "dest": "/painel.html" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/docs", "dest": "/docs.html" },
    { "src": "/sdk.js", "dest": "/sdk.js" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
